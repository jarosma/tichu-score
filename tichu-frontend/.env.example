# Browser API requests use the Vite proxy during local development.
VITE_API_BASE_URL=/api

# The start-tichu.sh script sets this automatically from the host LAN IP.
# Set this only when a fixed public URL should be used.
VITE_PUBLIC_URL=

# Optional local backend target for the Vite /api proxy.
TICHU_API_PROXY_TARGET=http://localhost:8080

# Optional overrides used by start-tichu.sh.
# TICHU_HOST_IP=127.0.0.1
# TICHU_NETWORK_INTERFACE=en0
# TICHU_CORS_ORIGINS=http://127.0.0.1:81
